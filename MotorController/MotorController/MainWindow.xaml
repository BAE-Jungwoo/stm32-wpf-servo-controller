
 <Window x:Class="MotorController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MotorController"
        mc:Ignorable="d"
        Title="Motor Controller" Height="520" Width="900">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E" />
        <SolidColorBrush x:Key="WindowForeground" Color="#E6E6E6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0097FF" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WindowForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="6,0" />
        </Style>

        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource WindowForeground}" Margin="0,0,24,0">
                    Motor Controller
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBox Width="120" Margin="0,0,8,0" Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,2" />
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ConnectCommand}">
                    <TextBlock VerticalAlignment="Center">Connect</TextBlock>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding DisconnectCommand}">
                    <TextBlock VerticalAlignment="Center">Disconnect</TextBlock>
                </Button>

                <TextBlock Text="{Binding ErrorText}" Foreground="Tomato" VerticalAlignment="Center" Margin="8,0,0,0" />

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding Activate}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Margin="0,0,6,0">⏻</TextBlock>
                        <TextBlock VerticalAlignment="Center">Activate</TextBlock>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding Deactivate}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" Margin="0,0,6,0">⭘</TextBlock>
                        <TextBlock VerticalAlignment="Center">Deactivate</TextBlock>
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Main control area -->
        <Border Grid.Row="1" Background="#252525" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryAction}" Command="{Binding Decelerate}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontSize="20" Margin="0,0,8,0">▼</TextBlock>
                            <TextBlock VerticalAlignment="Center">Decelerate</TextBlock>
                        </StackPanel>
                    </Button>

                    <StackPanel Width="380" VerticalAlignment="Center">
                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="10" Value="{Binding CurrentState.Speed, Mode=OneWay, TargetNullValue=0}" TickFrequency="1" IsSnapToTickEnabled="True" IsHitTestVisible="False" Focusable="False" />
                        <TextBlock TextAlignment="Center" Foreground="{StaticResource WindowForeground}" Margin="0,8,0,0">
                            <Run Text="Speed: "/>
                            <Run Text="{Binding CurrentState.Speed, StringFormat={}{0}, TargetNullValue=0}" />
                        </TextBlock>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryAction}" Command="{Binding Accelerate}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontSize="20" Margin="0,0,8,0">▲</TextBlock>
                            <TextBlock VerticalAlignment="Center">Accelerate</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


    </Grid>
</Window>
